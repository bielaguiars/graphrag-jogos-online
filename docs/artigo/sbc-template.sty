% Reimplementacao minima e compativel do sbc-template.sty (modelo SBC para artigos).
% Para submissao oficial, substitua por sbc-template.sty e sbc.bst do pacote da SBC
% (tambem disponivel no Overleaf como "SBC Conferences Template").
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2026/11/18 SBC template (compatible)]
\RequirePackage{times}
\RequirePackage[a4paper,top=3.5cm,bottom=2.5cm,left=3cm,right=3cm]{geometry}
\RequirePackage{titlesec}
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}
\titleformat{\section}{\normalfont\fontsize{13}{15}\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalfont\fontsize{12}{14}\bfseries}{\thesubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{12pt}{0pt}
\titlespacing*{\subsection}{0pt}{12pt}{0pt}
\newcommand{\@address}{}
\newcommand{\@email}{}
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\email}[1]{{\small\texttt{#1}}}
\renewcommand{\maketitle}{%
  \begin{center}
    {\fontsize{16}{20}\bfseries\@title\par}\vspace{12pt}
    {\fontsize{12}{14}\bfseries\@author\par}\vspace{12pt}
    {\fontsize{12}{14}\@address\par}
  \end{center}\vspace{6pt}}
\renewenvironment{abstract}{\par\noindent\begin{list}{}{\leftmargin=0.8cm\rightmargin=0.8cm}
  \item\relax\itshape\textbf{Abstract.}~}{\end{list}}
\newenvironment{resumo}{\par\noindent\begin{list}{}{\leftmargin=0.8cm\rightmargin=0.8cm}
  \item\relax\itshape\textbf{Resumo.}~}{\end{list}}
\renewcommand{\refname}{Referências}
\pagestyle{empty}
